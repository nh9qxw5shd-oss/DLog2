# Supabase — incident storage & historical trend charts
# Copy this file to .env.local and fill in your project values.
# Both values are safe to expose client-side (anon key is public by design).
# Secure access with Row Level Security policies in your Supabase project.

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ── Emergency Speed Restrictions (NRSDB scrape at log build) ──────────────────
# SERVER-ONLY. These are read by the /api/esr/snapshot route handler and are
# deliberately NOT prefixed NEXT_PUBLIC_ — they must never reach the browser.
# Use the account's own NRSDB login; the route automates the same
# getEsrsByRouteCode call the site's export button makes.
NRSDB_EMAIL=you@networkrail.co.uk
NRSDB_PASSWORD=your-password
NRSDB_ROUTECODE=EM          # optional, default EM
NRSDB_FILTER=imposed        # optional, default imposed

# Preferred key for writing ESR snapshots server-side (bypasses RLS). If unset
# the route falls back to NEXT_PUBLIC_SUPABASE_ANON_KEY, which migration 009's
# policies permit. SUPABASE_URL is optional and falls back to the public URL.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# SUPABASE_URL=https://<your-project-ref>.supabase.co

# nrsdb.uk's bot protection refuses logins from datacentre IPs (Vercel/Netlify
# functions included), so in practice the deployed app cannot pull for itself.
# Set a shared secret here and run scripts/nrsdb_push.py from a PC that can
# reach nrsdb.uk; it pushes the raw payload to /api/esr/ingest and the log
# build falls back to that stored snapshot automatically.
ESR_INGEST_TOKEN=<long-random-string>
